# ============================================================
#  Suporte Informática — .gitignore
# ============================================================

# ---------- Configuração sensível ----------
# Contém a chave do Web3Forms — NUNCA versionar
config.js

# ---------- Sistema operacional ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ---------- Editores / IDEs ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ---------- Logs e temporários ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak

# ---------- Dependências (caso adicione build no futuro) ----------
node_modules/
dist/
build/
.cache/

# ---------- Variáveis de ambiente ----------
.env
.env.local
.env.*.local
